# Reference only: this file is NOT loaded automatically by the application.
# Set variables in your shell or hosting dashboard before starting the process.
# Choose ONE profile. Local is the default; use demo for the public trial.
DATA_CLEAN_PROFILE=local

# Profile defaults (leave the optional overrides below unset):
# local: 100 MiB / 2,000,000 rows / 500 columns / 2 active operations / 24h expiry
# demo:    5 MiB /    25,000 rows /  50 columns / 1 active operation  /  1h expiry
# XLSX uncompressed-content cap: local 512 MiB, demo 32 MiB.
# Overrides take precedence over the profile. Do NOT copy local limits to demo.
# DATA_CLEAN_MAX_UPLOAD_MB=5
# DATA_CLEAN_MAX_ROWS=25000
# DATA_CLEAN_MAX_COLUMNS=50
# DATA_CLEAN_MAX_OPERATIONS=1
# DATA_CLEAN_MAX_EXPANDED_MB=32
# DATA_CLEAN_FILE_TTL_HOURS=1

# Storage must be outside the publicly served assets directory.
# DATA_CLEAN_STORAGE_DIR=C:/private-data-clean-storage
DATA_CLEAN_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
# Use 1 on an HTTPS deployment; keep 0 for local HTTP.
DATA_CLEAN_SECURE_COOKIE=0
