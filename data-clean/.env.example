# Reference settings: set these environment variables before starting the API.
# This file is not loaded automatically. Storage must be outside the web root.
# DATA_CLEAN_STORAGE_DIR=C:/private-data-clean-storage
DATA_CLEAN_MAX_UPLOAD_MB=100
DATA_CLEAN_MAX_ROWS=2000000
DATA_CLEAN_MAX_COLUMNS=500
DATA_CLEAN_FILE_TTL_HOURS=24
DATA_CLEAN_MAX_OPERATIONS=2
DATA_CLEAN_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
DATA_CLEAN_SECURE_COOKIE=0
